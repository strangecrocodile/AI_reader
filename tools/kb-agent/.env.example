# ============================================================
# kb-agent 环境变量模板
# 用法：复制本文件为 .env（.env 已被 .gitignore 忽略，密钥不会进 git），
#       在 .env 里填真实值后保存。代码在“建库/问答”时读取进程环境。
# ============================================================

# ---------- 1) 问答 LLM（生成回答用，OpenAI 兼容 chat 接口） ----------
# DeepSeek 官方示例（只需填 LLM_API_KEY 即可；base/model 已给默认）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-把DeepSeek的key填在这里
LLM_MODEL=deepseek-chat

# ---------- 2) 向量 embedding（语义检索用；三选一，全不配则用 BM25+哈希兜底） ----------
# 方案 A：OpenAI 兼容 /embeddings API（如硅基流动 SiliconFlow 的 BGE-M3）
# EMBED_BASE_URL=https://api.siliconflow.cn/v1
# EMBED_API_KEY=sk-填硅基流动的key
# EMBED_MODEL=BAAI/bge-m3
#
# 方案 B：本地模型（先装 sentence-transformers，首次会联网下载约 1-2GB 模型）
# EMBED_MODEL=BAAI/bge-m3
#
# 方案 C：什么都不填 → 自动用 BM25+哈希混合（离线可用，近义词召回较弱）

# ---------- 3) LangSmith 追踪（可选：agent 运行轨迹观测） ----------
# 到 smith.langchain.com 建项目并复制 API Key（形如 lsv2_...）填入
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_把LangSmith的key填在这里
LANGCHAIN_PROJECT=kb-agent

# ---------- 说明 ----------
# · 只填第 1 部分：DeepSeek 负责“照着检索到的原文回答”，检索用 BM25+哈希——
#   能跑通完整闭环，但“切线斜率↔导数几何意义”这类同义问法召回较弱；
# · 第 2 部分也填上：检索才有真语义。DeepSeek 官方通常不提供 /embeddings，
#   所以 embedding 一般用硅基流动等厂商的接口，或本地 bge-m3 模型。
